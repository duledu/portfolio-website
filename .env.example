# Copy these variable NAMES into Vercel → Project Settings → Environment
# Variables. Do not put real values in this file, and never commit a real
# password anywhere in this repo — Vercel env vars are the only place the
# real value should live. See middleware.js for how each one is used.

# Required to turn the password gate on. Leave unset/empty in any
# environment where the site should stay fully public.
PORTFOLIO_PASSWORD=

# Optional. Set to "false" to force the gate off even if PORTFOLIO_PASSWORD
# is set (temporarily make the site public without deleting the password).
PORTFOLIO_LOCK_ENABLED=

# Optional but recommended. A separate secret used to sign the session
# cookie. If unset, PORTFOLIO_PASSWORD itself is used as the signing key.
PORTFOLIO_SESSION_SECRET=
